<div class="tab {{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <p class="notes">Additional attributes for controlling how the tile can be interacted with.</p>
    {{#each dga.BooleanTileSettings as |setting|}}
    <div class="form-group">
      <label>{{setting.label}}</label>
      <div class="form-fields">
        <input type="checkbox" name="{{setting.key}}" {{#if setting.value}}checked{{/if}}>
      </div>
      {{#if setting.hint}}<p class="hint">{{setting.hint}}</p>{{/if}}
    </div>
    {{/each}}
    <div class="form-group">
      <label>Visible Distance</label>
      <div class="form-fields">
        <input type="number" name="flags.{{MODULENAME}}.visibleDistance" value="{{dga.visibleDistance}}" min="0" step="1" />
      </div>
      <p class="hint">The number of grid spaces away the tile's texture can be seen from. Unset for infinite, 0 for always invisible.</p>
    </div>
    <div class="form-group">
      <label>Interaction Sound</label>
      <div class="form-fields">
        <select name="flags.{{MODULENAME}}.interactionSound">
          <option value="" default>None</option>
          {{#each dga.sounds as |v k|}}
          <option value="{{k}}" {{#if (eq k ../dga.interactionSound)}}selected{{/if}}>{{v}}</option>
          {{/each}}
          <option class="custom-interaction" value="{{#if dga.isCustomSound}}{{dga.customSound}}{{else}}custom{{/if}}" {{#if dga.isCustomSound}}selected{{/if}}>Custom</option>
        </select>
      </div>
    </div>
    <div class="form-group custom-sound" {{#unless dga.isCustomSound}}style='display:none'{{/unless}}>
      <label>Custom Interaction Sound</label>
      <div class="form-fields">
        <file-picker class="custom-interaction" type="audio" value="{{#if dga.isCustomSound}}{{dga.customSound}}{{/if}}"></file-picker>
      </div>
    </div>
    {{#if dga.permissions.MACRO_SCRIPT}}
    <fieldset class="dga-script-editor">
      <legend>{{ localize "DGA.Fields.InteractionScript.label" }}</legend>
      <label>Execute as GM? <input type="checkbox" name="flags.{{MODULENAME}}.scriptGm" {{#if dga.scriptGm}}checked{{/if}}></label>
      {{formInput dga.scriptField value=dga.script language="javascript" elementType="code-mirror"
        aria=(object label=(localize dga.scriptField.label))}}
      <p class="hint">{{ localize "DGA.Fields.InteractionScript.hint" }}</p>
    </fieldset>
    {{/if}}
    {{#if dga.reinforcements}}
    <fieldset class="dga-reinforcements">
      <legend>Reinforcements</legend>
      <div class="form-group">
        <label>Trigger</label>
        <div class="form-fields">
          <select name="flags.{{MODULENAME}}.reinforcements.trigger">
            <option value="script" {{#if (eq dga.reinforcements.trigger "script")}}selected{{/if}}>Via Script</option>
            <option value="scene"  {{#if (eq dga.reinforcements.trigger "scene")}}selected{{/if}}>Scene Creation</option>
            <option value="round"  {{#if (eq dga.reinforcements.trigger "round")}}selected{{/if}}>Round End</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Enabled</label>
        <div class="form-fields">
          <input type="checkbox" name="flags.{{MODULENAME}}.reinforcements.enabled" {{#if dga.reinforcements.enabled}}checked{{/if}}>
        </div>
      </div>
      <div class="form-group">
        <label>From end of round</label>
        <div class="form-fields">
          <input type="number" name="flags.{{MODULENAME}}.reinforcementRound" min="1" step="1" value="{{dga.reinforcementRound}}">
        </div>
        <p class="hint">Round End only. Spawns one reinforcement at the end of this round and every round after, and adds it to the combat.</p>
      </div>
      <div class="form-group">
        <label>Wait while occupied</label>
        <div class="form-fields">
          <input type="checkbox" name="flags.{{MODULENAME}}.waitWhileOccupied" {{#if dga.waitWhileOccupied}}checked{{/if}}>
        </div>
        <p class="hint">If ticked (default), the platform skips spawning when a token already occupies the cell and will try again next round.</p>
      </div>
    </fieldset>
    {{/if}}
  </div>