<form>
    <div class="form-group highlight-colors">
        <label>{{localize "DGA.Highlight.Label"}}</label>
        <div class="form-fields color-swatches">
            {{#each colors}}
            <button type="button" class="color-swatch" data-color="{{this.value}}" style="background-color: {{this.value}};" title="{{this.label}}"></button>
            {{/each}}
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "DGA.Highlight.Custom"}}</label>
        <div class="form-fields">
            <input type="color" name="custom-color" value="{{ customColor }}">
            <button type="button" name="apply-custom">{{localize "DGA.Highlight.Apply"}}</button>
        </div>
    </div>
    <button type="button" name="clear">{{localize "DGA.Highlight.Clear"}}</button>
</form>
