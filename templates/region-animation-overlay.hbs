<div class="standard-form">
  <div class="form-group">
    <label>{{ localize "DGA.RegionBehaviorConfig.AnimationOverlay.animationSrc.label" }}</label>
    <div class="form-fields">
      <file-picker type="any" name="system.animationSrc" value="{{region.system.animationSrc}}"></file-picker>
    </div>
    <p class="hint">{{ localize "DGA.RegionBehaviorConfig.AnimationOverlay.animationSrc.hint" }}</p>
  </div>
  <div class="form-group">
    <label>{{ localize "DGA.RegionBehaviorConfig.AnimationOverlay.fps.label" }}</label>
    <div class="form-fields">
      <input type="number" name="system.fps" value="{{region.system.fps}}" min="1" max="60" step="1" />
    </div>
    <p class="hint">{{ localize "DGA.RegionBehaviorConfig.AnimationOverlay.fps.hint" }}</p>
  </div>
</div>
